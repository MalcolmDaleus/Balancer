# Production template for https://balancer.malcolmjdstudio.com (Hostinger).
# Copy to .env.production on your PC (gitignored), fill in the two secrets,
# then upload it to the server as balancer-app/.env. Never commit the filled copy.

APP_NAME=Balancer
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://balancer.malcolmjdstudio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# hPanel prefixes the database and user names with your account id (u123456789_).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_balancer
DB_USERNAME=u123456789_balancer
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=balancer.malcolmjdstudio.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# No mailbox: reset links are created by admins in /admin/password-resets.
AUTH_PASSWORD_RESET_EXPIRE=1440
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@malcolmjdstudio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
